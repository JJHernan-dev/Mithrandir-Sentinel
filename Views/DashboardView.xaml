<UserControl x:Class="Mithrandir_Sentinel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Background="#111827">

        <StackPanel Margin="30">

            <TextBlock Text="Security Dashboard"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="System monitoring overview"
                       Foreground="#94A3B8"
                       FontSize="16"
                       Margin="0,10,0,30"/>

            <!-- Cards -->
            <WrapPanel>

                <Border Width="220"
                        Height="120"
                        Background="#1E293B"
                        CornerRadius="10"
                        Margin="0,0,20,20">

                    <StackPanel Margin="15">

                        <TextBlock Text="Active Connections"
                                   Foreground="#94A3B8"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding ActiveConnections}"
           Foreground="White"
           FontSize="36"
           FontWeight="Bold"
           Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <Border Width="220"
                        Height="120"
                        Background="#1E293B"
                        CornerRadius="10">

                    <StackPanel Margin="15">

                        <TextBlock Text="Alerts"
                                   Foreground="#94A3B8"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding Alerts}"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

            <DataGrid ItemsSource="{Binding Connections}"
          AutoGenerateColumns="False"
          Height="350"
          Margin="0,20,0,0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Local IP"
                            Binding="{Binding LocalAddress}"
                            Width="*"/>

                    <DataGridTextColumn Header="Local Port"
                            Binding="{Binding LocalPort}"
                            Width="*"/>

                    <DataGridTextColumn Header="Remote IP"
                            Binding="{Binding RemoteAddress}"
                            Width="*"/>

                    <DataGridTextColumn Header="Remote Port"
                            Binding="{Binding RemotePort}"
                            Width="*"/>

                    <DataGridTemplateColumn Header="State"
                        Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="8,4"
                    CornerRadius="6"
                    HorizontalAlignment="Left">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                Value="#334155"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding State}"
                                         Value="Established">

                                                    <Setter Property="Background"
                                        Value="#14532D"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}"
                                         Value="TimeWait">

                                                    <Setter Property="Background"
                                        Value="#9A3412"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}"
                                         Value="CloseWait">

                                                    <Setter Property="Background"
                                        Value="#991B1B"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding State}"
                           Foreground="White"
                           FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

        
        
    </Grid>

</UserControl>