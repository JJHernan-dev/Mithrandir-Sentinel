<UserControl x:Class="Mithrandir_Sentinel.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid Background="#111827">

        <StackPanel Margin="30">

            <TextBlock Text="Active TCP Connections"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Grid Width="350"
                  Height="42"
                  Margin="0,0,0,20"
                  HorizontalAlignment="Left">

                <!-- BACKGROUND -->

                <Border Background="#1E293B"
                        CornerRadius="10"
                        BorderBrush="#334155"
                        BorderThickness="1"/>

                <!-- SEARCH ICON -->

                <TextBlock Text="🔍"
                           Foreground="#64748B"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <!-- SEARCH BOX -->

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="14"
                         Padding="36,0,10,0"
                         VerticalContentAlignment="Center">

                    <TextBox.Style>

                        <Style TargetType="TextBox">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="TextBox">

                                        <Grid>

                                            <ScrollViewer x:Name="PART_ContentHost"/>

                                            <!-- PLACEHOLDER -->

                                            <TextBlock Text="Search IP, process, state..."
                                                       Foreground="#64748B"
                                                       Margin="36,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}"
                                                                         Value="">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Grid>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </TextBox.Style>

                </TextBox>

            </Grid>

            <DataGrid ItemsSource="{Binding FilteredConnections}"
                      AutoGenerateColumns="False"
                      Height="600">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Local IP"
                                        Binding="{Binding LocalAddress}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Local Port"
                                        Binding="{Binding LocalPort}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Remote IP"
                                        Binding="{Binding RemoteAddress}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Remote Port"
                                        Binding="{Binding RemotePort}"
                                        Width="*"/>

                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding ProcessId}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Process"
                                        Binding="{Binding ProcessName}"
                                        Width="*"/>

                    <DataGridTemplateColumn Header="Risk"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="8,4"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#14532D"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RiskLevel}"
                                                             Value="Medium">

                                                    <Setter Property="Background"
                                                            Value="#9A3412"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding RiskLevel}"
                                                             Value="High">

                                                    <Setter Property="Background"
                                                            Value="#991B1B"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding RiskLevel}"
                                               Foreground="White"
                                               FontWeight="Bold"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="State"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="8,4"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#334155"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding State}"
                                                             Value="ESTABLISHED">

                                                    <Setter Property="Background"
                                                            Value="#14532D"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}"
                                                             Value="TIME_WAIT">

                                                    <Setter Property="Background"
                                                            Value="#9A3412"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}"
                                                             Value="CLOSE_WAIT">

                                                    <Setter Property="Background"
                                                            Value="#991B1B"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding State}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

        <!-- LOADING OVERLAY -->

        <Grid Background="#AA0B1220"
              Visibility="{Binding IsLoading,
                           Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="180"
                             Height="6"
                             IsIndeterminate="True"
                             Foreground="#00FFAA"
                             Background="#1E293B"/>

                <TextBlock Text="Initializing Mithrandir Sentinel..."
                           Foreground="White"
                           FontSize="16"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>


    </Grid>

</UserControl>