<UserControl x:Class="Mithrandir_Sentinel.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/">

    <UserControl.Resources>

        <Style x:Key="LinkButtonStyle"
                TargetType="Button">

            <Setter Property="Background"
                    Value="#0F172A"/>
            <Setter Property="Foreground"
                    Value="#00FFAA"/>
            <Setter Property="BorderBrush"
                    Value="#1E293B"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Width"
                    Value="110"/>
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                    Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#132233"/>

                                <Setter Property="Foreground"
                                        Value="#5EEAD4"/>

                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#00FFAA"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#0B1220"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="#111827">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- TITLE -->

                <TextBlock Text="Settings"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <!-- GENERAL -->

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="General"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,0"/>

                        <TextBlock Text="Controls how frequently the application updates active connections, alerts, and monitoring data in real time."
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Refresh interval:"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>

                            <ComboBox Width="120"
                                      SelectedValue="{Binding RefreshInterval}"
                                      SelectedValuePath="Tag">

                                <ComboBoxItem Content="1 sec"
                                        Tag="1"/>
                                <ComboBoxItem Content="2 sec"
                                        Tag="2"/>
                                <ComboBoxItem Content="5 sec"
                                        Tag="5"/>

                            </ComboBox>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- DETECTION -->

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Detection"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,0"/>

                        <TextBlock Text="Generates simulated threat alerts to test the alert system and visualize real-time detection behavior."
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,10"/>

                        <CheckBox Content="Enable demo alerts"
                                  Foreground="White"
                                  FontSize="15"
                                  Margin="0,0,0,15"
                                  IsChecked="{Binding EnableDemoAlerts}"/>
                    </StackPanel>

                </Border>



                <!-- ABOUT -->

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>

                        <!-- TITLE -->

                        <TextBlock Text="About"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- APP NAME -->

                        <TextBlock Text="Mithrandir Sentinel v0.3"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <!-- DESCRIPTION -->

                        <TextBlock Text="Defensive cybersecurity monitoring tool built with C# WPF and MVVM."
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Designed for real-time TCP connection monitoring and threat visualization."
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,20"/>

                        <!-- AUTHOR -->

                        <TextBlock Text="Author"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="15"/>

                        <TextBlock Text="© 2026 Juan Jesús González Hernández"
                                   Foreground="#CBD5E1"
                                   Margin="0,5,0,20"/>


                        <!-- LINKS -->

                        <TextBlock Text="Links"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">

                            <!-- GITHUB -->
                            <Button Content="GitHub"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="GitHubButton_Click"/>

                            <!-- LINKEDIN -->
                            <Button Content="LinkedIn"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="LinkedInButton_Click"/>

                            <!-- WEBSITE -->
                            <Button Content="Website"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="WebsiteButton_Click"/>

                            <!-- WEBSITE -->
                            <Button Content="Portfolio"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Click="PortfolioButton_Click"/>

                        </StackPanel>



                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>