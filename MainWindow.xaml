<Window x:Class="Mithrandir_Sentinel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Mithrandir_Sentinel.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    mc:Ignorable="d"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    Title="Mithrandir Sentinel"
    Width="1400"
    Height="800"
    MinWidth="1100"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#111827"
    WindowStyle="None"
    ResizeMode="CanResize"
    AllowsTransparency="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    shell:WindowChrome.WindowChrome="{DynamicResource CustomChrome}">

    <Window.Resources>

        <shell:WindowChrome x:Key="CustomChrome"
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />

    </Window.Resources>

    <Grid>

        <!-- ROWS -->

        <Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <RowDefinition Height="48" />

            <!-- CONTENT -->
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- TITLE BAR -->

        <Border Grid.Row="0"
            Background="#040a11">


            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <!-- APP TITLE -->

                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="20,0">

                    <!-- TITLE -->
                    <TextBlock Text="Mithrandir Sentinel"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />


                </StackPanel>

                <!-- WINDOW BUTTONS -->

                <StackPanel Grid.Column="1"
                    Orientation="Horizontal">

                    <!-- MINIMIZE -->

                    <Button Width="46"
                        Height="48"
                        Content="—"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Cursor="Hand"
                        Click="MinimizeButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}">

                                    <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#1E293B" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#334155" />
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <!-- MAXIMIZE -->

                    <Button Width="46"
                        Height="48"
                        Content="□"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Cursor="Hand"
                        Click="MaximizeButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}">

                                    <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#1E293B" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#334155" />
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <!-- CLOSE -->

                    <Button Width="46"
                        Height="48"
                        Content="X"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Cursor="Hand"
                        Click="CloseButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}">

                                    <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#1E293B" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="#334155" />
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <ColumnDefinition Width="260" />

                <!-- CONTENT -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->

            <Border Grid.Column="0"
                Background="#040a11">

                <Grid Margin="20">

                    <Grid.RowDefinitions>

                        <!-- TOP CONTENT -->
                        <RowDefinition Height="*" />

                        <!-- BOTTOM INFO -->
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <!-- TOP -->

                    <StackPanel>

                        <!-- LOGO -->

                        <StackPanel Margin="0,0,0,40"
                            HorizontalAlignment="Center">

                            <Image Source="/Assets/Images/logo1.png"
                                Width="190"
                                Height="172"
                                Stretch="Uniform" />

                        </StackPanel>

                        <!-- MENU -->

                        <Button Content="Dashboard"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowDashboardCommand}"
                            Height="45"
                            Margin="0,0,0,10" />

                        <Button Content="Connections"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowConnectionsCommand}"
                            Height="45"
                            Margin="0,0,0,10" />

                        <Button Content="Alerts"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowAlertsCommand}"
                            Height="45"
                            Margin="0,0,0,10" />

                        <Button Content="Settings"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            Height="45" />

                    </StackPanel>

                    <!-- BOTTOM STATUS -->

                    <StackPanel Grid.Row="1"
                        Margin="0,25,0,5">

                        <!-- DIVIDER -->

                        <Border Height="1"
                            Background="#1E293B"
                            Margin="0,0,0,15" />

                        <!-- VERSION -->

                        <TextBlock Text="Mithrandir Sentinel v0.3"
                            Foreground="#64748B"
                            FontSize="11"
                            HorizontalAlignment="Center" />

                        <!-- STATUS -->

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0">

                            <!-- STATUS DOT -->

                            <Border Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="#00FFAA"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">

                                <Border.Effect>

                                    <DropShadowEffect Color="#00FFAA"
                                        BlurRadius="12"
                                        ShadowDepth="0"
                                        Opacity="0.9" />

                                </Border.Effect>

                            </Border>

                            <!-- STATUS TEXT -->

                            <TextBlock Text="Monitoring active"
                                Foreground="#00FFAA"
                                FontSize="11"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- CONTENT AREA -->

            <Border Grid.Column="1"
                Background="#111827">

                <ContentControl Content="{Binding CurrentView}" />

            </Border>

        </Grid>

    </Grid>

</Window>